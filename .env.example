# Every setting is optional. The defaults run fully offline with no API keys:
# the `hashing` embedder and `extractive` generator are deterministic local
# implementations, which is why the test suite and CI need no secrets.
#
# Copy to `.env` and uncomment what you want to change.

# ---------------------------------------------------------------- storage
# KB_DATA_DIR=./data

# ------------------------------------------------------------- embeddings
# hashing (default, offline) | voyage | openai | local
# KB_EMBEDDING_PROVIDER=voyage
# KB_EMBEDDING_MODEL=voyage-3
# KB_EMBEDDING_DIM=512               # only used by the hashing embedder
# KB_EMBEDDING_BATCH_SIZE=64

# -------------------------------------------------------------- retrieval
# KB_RETRIEVAL_STRATEGY=hybrid       # hybrid | dense | lexical
# KB_FUSION_METHOD=rrf               # rrf | weighted | max
# KB_TOP_K=8
# KB_CANDIDATE_K=50                  # candidates per retriever, before fusion
# KB_RRF_K=60                        # RRF damping constant
# KB_LEXICAL_WEIGHT=0.4              # defaults flip to favour BM25 when the
# KB_DENSE_WEIGHT=0.6                #   offline hashing embedder is in use
# KB_USE_MMR=false                   # diversify the final result set
# KB_MMR_LAMBDA=0.7                  # 1.0 = pure relevance, 0.0 = pure diversity

# -------------------------------------------------------------- reranking
# none | lexical (offline) | cross_encoder | cohere | voyage | llm
# KB_RERANK_PROVIDER=cross_encoder
# KB_RERANK_ENABLED=true
# KB_RERANK_TOP_N=30

# ------------------------------------------------------------- generation
# extractive (default, offline) | anthropic | openai
# KB_GENERATION_PROVIDER=anthropic
# KB_GENERATION_MODEL=
# KB_CONTEXT_TOKEN_BUDGET=6000

# ----------------------------------------------------------- verification
# KB_VERIFY_CITATIONS=true
# KB_VERIFICATION_THRESHOLD=0.5

# -------------------------------------------------------------- chunking
# recursive (default) | sentence | fixed | semantic
# KB_CHUNK_STRATEGY=recursive
# KB_CHUNK_SIZE=1200
# KB_CHUNK_OVERLAP=180

# --------------------------------------------------------------- crawling
# KB_WEB_CRAWL_MAX_PAGES=25
# KB_WEB_CRAWL_MAX_DEPTH=2

# -------------------------------------------------------------------- api
# KB_API_HOST=0.0.0.0
# KB_API_PORT=8000
# KB_CORS_ORIGINS=http://localhost:5173
# KB_LOG_LEVEL=INFO

# ------------------------------------------------------------ credentials
# Unprefixed names are honoured too, so an existing shell just works.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# COHERE_API_KEY=
